# Copy to .env for local development. On Coolify, set these as the
# application's environment variables instead. Never commit the real values.

# --- Database (Postgres on Coolify) ---
# Local dev: the database's public URL. Production: its internal URL.
DATABASE_URL="postgresql://amanah:CHANGE_ME@localhost:5432/amanah?schema=public"

# --- Storefront ---
# Origins allowed to call the API from a browser, comma-separated, no trailing slash.
# The first one is also used to preview storefront-hosted images (/images/...) in the admin.
STOREFRONT_ORIGIN="http://localhost:5173"
STORE_NAME="Amanah Jewellery"
STORE_CURRENCY="CAD"

# --- Admin login ---
ADMIN_EMAIL="owner@example.com"
# Generate with: npm run admin:hash -- "a-long-password"
ADMIN_PASSWORD_HASH=""
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Razorpay (use Test Mode keys until launch) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""

# --- Product photos (MinIO on Coolify, S3-compatible) ---
S3_ENDPOINT="https://minio-api.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="amanah-products"
# Public base URL for photos. Defaults to S3_ENDPOINT/S3_BUCKET.
S3_PUBLIC_URL=""

# --- Email (Resend) ---
RESEND_API_KEY=""
# A sender on a domain verified in Resend, e.g. orders@yourdomain.com
EMAIL_FROM=""
# The shop's inbox: receives contact messages and new-order alerts.
SHOP_EMAIL=""
