// Amanah Jewellery backend schema.
// Money is stored in cents (whole numbers) in the store currency, so totals
// never pick up rounding errors. The API converts to whole units for the
// storefront, which formats prices without decimals.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  // Kept short and stable (the demo catalogue uses ids like "n1"), because the
  // storefront saves product ids in shoppers' carts and wishlists.
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  category    String // a Category id, e.g. necklaces
  short       String
  description String         @default("")
  price       Int // cents
  salePrice   Int? // cents
  inStock     Boolean        @default(true)
  featured    Boolean        @default(false)
  isNew       Boolean        @default(false)
  tone        String         @default("ivory") // placeholder colour: ivory | champagne | deep
  variants    Json           @default("[]") // [{ "name": "Ring size", "options": ["5", "6"] }]
  specs       Json           @default("[]") // [{ "label": "Material", "value": "..." }]
  sortOrder   Int            @default(0) // lower = newer, used by "Newest" sorting
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
}

// Shop categories, managed on the admin's Categories page. Product.category holds a
// category's id (its slug, e.g. "necklaces"); a category with products cannot be deleted.
model Category {
  id          String   @id // slug used in URLs and in Product.category
  name        String
  tagline     String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // MinIO URL on Coolify, or a storefront path such as /images/x.jpg
  alt       String  @default("")
  view      String  @default("") // e.g. "Front view", "Detail", "Worn"
  position  Int     @default(0)
  storageKey String? // object key in MinIO, so the file can be deleted with the row

  @@index([productId, position])
}

model Order {
  id                String      @id @default(cuid())
  status            OrderStatus @default(PENDING)
  email             String
  customer          Json // name, phone, shipping address
  subtotal          Int // cents: the amount charged, after any coupon discount, shipping included
  couponCode        String? // the coupon used, if any
  discount          Int         @default(0) // cents taken off by the coupon
  shipping          Int         @default(0) // cents charged for delivery
  shippingZone      String? // name of the zone that priced the delivery
  currency          String      @default("CAD")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  paidAt            DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
}

// Discount codes, managed on the admin's Coupons page and entered at checkout.
model Coupon {
  code        String    @id // stored in capitals, e.g. WELCOME10
  type        String // percent | amount
  value       Int // percent: 1-90; amount: cents
  minSubtotal Int       @default(0) // cents; the bag must reach this before the code works
  maxUses     Int? // empty = unlimited
  uses        Int       @default(0) // paid orders that used it
  expiresAt   DateTime? // the code stops working after this moment
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String // copied at purchase time, so later renames don't change old orders
  variant   Json?
  qty       Int
  unitPrice Int // cents, the price actually charged
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String?
  message   String
  createdAt DateTime @default(now())
}

// A delivery area and its price. Checkout picks the zone with the longest matching
// PIN prefix, then one listing the shopper's state, then one with neither (catch-all).
model ShippingZone {
  id          String   @id @default(cuid())
  name        String
  rate        Int // cents
  freeAbove   Int? // cents: delivery is free when the order reaches this
  pinPrefixes String[]
  states      String[]
  minDays     Int
  maxDays     Int
  priority    Int      @default(0) // breaks ties: higher wins
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Shop settings edited in the admin, one row per key (e.g. "contactEmail").
model Setting {
  key   String @id
  value String
}

model NewsletterSubscriber {
  email     String   @id
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  REFUNDED
}
