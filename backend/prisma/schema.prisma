// Amanah Jewellery backend schema.
// Money is stored in cents (whole numbers) in the store currency, so totals
// never pick up rounding errors. The API converts to whole units for the
// storefront, which formats prices without decimals.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  // Kept short and stable (the demo catalogue uses ids like "n1"), because the
  // storefront saves product ids in shoppers' carts and wishlists.
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  category    String // necklaces | earrings | rings | bracelets | designer
  short       String
  description String         @default("")
  price       Int // cents
  salePrice   Int? // cents
  inStock     Boolean        @default(true)
  featured    Boolean        @default(false)
  isNew       Boolean        @default(false)
  tone        String         @default("ivory") // placeholder colour: ivory | champagne | deep
  variants    Json           @default("[]") // [{ "name": "Ring size", "options": ["5", "6"] }]
  specs       Json           @default("[]") // [{ "label": "Material", "value": "..." }]
  sortOrder   Int            @default(0) // lower = newer, used by "Newest" sorting
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // MinIO URL on Coolify, or a storefront path such as /images/x.jpg
  alt       String  @default("")
  view      String  @default("") // e.g. "Front view", "Detail", "Worn"
  position  Int     @default(0)
  storageKey String? // object key in MinIO, so the file can be deleted with the row

  @@index([productId, position])
}

model Order {
  id                String      @id @default(cuid())
  status            OrderStatus @default(PENDING)
  email             String
  customer          Json // name, phone, shipping address
  subtotal          Int // cents
  currency          String      @default("CAD")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  paidAt            DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String // copied at purchase time, so later renames don't change old orders
  variant   Json?
  qty       Int
  unitPrice Int // cents, the price actually charged
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String?
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  email     String   @id
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  REFUNDED
}
